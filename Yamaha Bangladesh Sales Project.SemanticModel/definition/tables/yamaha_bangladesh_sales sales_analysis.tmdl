table 'yamaha_bangladesh_sales sales_analysis'
	lineageTag: 8224e3b4-f92e-49f6-a14f-295e027b6016

	measure 'Total Net Revenue' = SUM('yamaha_bangladesh_sales sales_analysis'[net_revenue])
		formatString: "৳"#,##0
		lineageTag: 463ebd81-ece0-4d59-a179-857665ada46f

	measure 'Total Gross Revenue' = SUM('yamaha_bangladesh_sales sales_analysis'[gross_revenue])
		formatString: "৳"#,##0
		lineageTag: 7ef1074f-2cb6-4fbc-82e4-02f5cbd006f6

	measure 'Total Unit Sold' = SUM('yamaha_bangladesh_sales sales_analysis'[quantity])
		formatString: 0
		lineageTag: e50631b5-6723-4e21-9490-982b23c64491

	measure 'Total Discount' = SUM('yamaha_bangladesh_sales sales_analysis'[discount_bdt])
		formatString: "৳"#,##0
		lineageTag: 67c1d44b-0f8e-4a34-9f4d-3c6683519760

	measure 'Unique Customer' = DISTINCTCOUNT('yamaha_bangladesh_sales sales_analysis'[customer_id])
		formatString: 0
		lineageTag: a6d2a77a-9e2b-4293-9bb1-870580421af8

	measure 'Discount Rate' = DIVIDE([Total Discount],[Total Gross Revenue],0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0a6d3f22-af1b-49a4-b694-3449b2d5ad50

	measure 'YoY Growth %' = DIVIDE([Total Net Revenue]-[Previous Year Revenue],[Previous Year Revenue],0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 01275e6e-ef2a-4b41-9a01-31c969e28d93

	measure 'Previous Year Revenue' = CALCULATE([Total Net Revenue],SAMEPERIODLASTYEAR('Date Table'[Date]))
		formatString: "৳"#,##0
		lineageTag: d18e0212-675b-45b7-a048-ee7861cd2130

	measure 'Total Orders' = COUNTROWS('yamaha_bangladesh_sales sales_analysis')
		formatString: 0
		lineageTag: 8a1b6b23-2f2d-4e77-9e0a-1a9e5c2f6b40

	measure 'Avg Order Value' = DIVIDE([Total Net Revenue],[Total Orders],0)
		formatString: "৳"#,##0
		lineageTag: 3c7a9e10-4c5b-4a2e-8f1d-6b7e0a2d5c91

